rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSystemAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'mundhaidshj@gmail.com';
    }

    // الموظف = حساب أضافه مدير النظام إلى قائمة staff
    function isStaff() {
      return isSystemAdmin()
        || (request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'password'
          && exists(/databases/$(database)/documents/staff/$(request.auth.token.email)));
    }

    function codePath(code) {
      return /databases/$(database)/documents/accessCodes/$(code);
    }

    // المتعامل يرسل طلباً واحداً فقط بالرمز الذي مسحه (خلال 30 دقيقة)
    // ويجب تعليم الرمز كمستخدم في نفس العملية
    function hasValidAccessCode(inquiryId) {
      return request.resource.data.accessCode is string
        && request.resource.data.accessCode.matches('[a-z0-9]{6,32}')
        && get(codePath(request.resource.data.accessCode)).data.claimedBy == request.auth.uid
        && get(codePath(request.resource.data.accessCode)).data.claimedAt + duration.value(30, 'm') > request.time
        && !('submittedAt' in get(codePath(request.resource.data.accessCode)).data)
        && getAfter(codePath(request.resource.data.accessCode)).data.inquiryId == inquiryId;
    }

    match /staff/{email} {
      allow read: if isStaff();
      allow write: if isSystemAdmin();
    }

    // رموز QR: المتعامل يتحقق من رمزه فقط، ولا يستطيع رؤية قائمة الرموز
    match /accessCodes/{code} {
      allow get: if request.auth != null;
      allow list: if isStaff();

      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['expiresAt', 'createdAt'])
        && request.resource.data.expiresAt is timestamp;

      // 1) حجز الرمز عند المسح (لأول شخص فقط)
      // 2) تعليمه كمستخدم عند إرسال الطلب
      allow update: if request.auth != null && (
        (!('claimedBy' in resource.data)
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['claimedBy', 'claimedAt'])
          && request.resource.data.claimedBy == request.auth.uid
          && request.resource.data.claimedAt == request.time)
        ||
        (resource.data.claimedBy == request.auth.uid
          && !('submittedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['submittedAt', 'inquiryId'])
          && request.resource.data.submittedAt == request.time
          && existsAfter(/databases/$(database)/documents/inquiries/$(request.resource.data.inquiryId)))
      );

      allow delete: if isStaff();
    }

    match /inquiries/{inquiryId} {
      allow read: if isStaff();

      allow create: if request.auth != null
        && (isStaff() || hasValidAccessCode(inquiryId))
        && request.resource.data.status in ['لم يتم الرد', 'تم الرد']
        && request.resource.data.name is string
        && request.resource.data.inquiry is string
        && request.resource.data.inquiry.size() < 5000;

      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'replyNotes'])
        && request.resource.data.status in ['لم يتم الرد', 'تم الرد'];

      allow delete: if isSystemAdmin();
    }
  }
}
